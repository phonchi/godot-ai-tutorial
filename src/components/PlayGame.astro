---
interface Props {game:'2d'|'3d';title:string;}
const {game,title}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="play-card" data-src={`${base}play/${game}/index.html`} data-title={title}>
 <div class="play-placeholder">
  <picture>
   <source media="(prefers-reduced-motion: reduce)" srcset={`${base}previews/${game}.png`} />
   <img src={`${base}previews/${game}.webp`} alt={`${title}的實際遊戲畫面`} width="720" height="450" loading="lazy"/>
  </picture>
  <p>按下「載入遊戲」才下載 Godot 執行檔（約 40 MB）。請使用支援 WebGL 2 的桌機瀏覽器，鍵盤或手把皆可。</p>
 </div>
 <button type="button" class="course-link primary load-game">載入遊戲</button>
 <a class="course-link" href={`${base}play/${game}/index.html`} target="_blank" rel="noopener">獨立視窗試玩 ↗</a>
 <p class="touch-notice">這款遊戲需要鍵盤或手把，請改用桌機或筆電遊玩。也可以先看上方的實際畫面，或到下載區取得專案。</p>
 <p class="game-status" role="status"></p>
</div>
<script>
 const placeholders=new WeakMap<HTMLElement,Node>();
 const cards=Array.from(document.querySelectorAll<HTMLElement>('.play-card'));
 const touchOnly=matchMedia('(pointer: coarse)').matches&&!matchMedia('(any-pointer: fine)').matches;
 function unload(card:HTMLElement){
  const frame=card.querySelector('iframe');const original=placeholders.get(card);
  if(frame&&original)frame.replaceWith(original.cloneNode(true));
  card.querySelector('.load-game')!.textContent='載入遊戲';
  card.querySelector('.game-status')!.textContent='';
 }
 cards.forEach(card=>{
 if(touchOnly)card.classList.add('is-touch');
 const original=card.querySelector('.play-placeholder');if(original)placeholders.set(card,original.cloneNode(true));
 card.querySelector<HTMLButtonElement>('.load-game')!.addEventListener('click',()=>{
  if(card.querySelector('iframe')){unload(card);return;}
  const placeholder=card.querySelector('.play-placeholder');if(!placeholder)return;
  const canvas=document.createElement('canvas');
  if(!canvas.getContext('webgl2')){card.querySelector('.game-status')!.textContent='此瀏覽器未提供 WebGL 2，請下載專案在 Godot 執行，或改用支援的桌機瀏覽器。';return;}
  cards.filter(other=>other!==card).forEach(unload);
  const iframe=document.createElement('iframe');iframe.src=card.dataset.src!;iframe.title=card.dataset.title!;iframe.allow='autoplay; fullscreen; gamepad';iframe.setAttribute('allowfullscreen','');
  iframe.addEventListener('load',()=>{if(card.contains(iframe))card.querySelector('.game-status')!.textContent='遊戲頁面已載入。點一下遊戲畫面取得鍵盤焦點，再按 Enter（手把按 A 或 Start）開始。';});
  placeholder.replaceWith(iframe);card.querySelector('.load-game')!.textContent='卸載遊戲';
 });});
</script>
